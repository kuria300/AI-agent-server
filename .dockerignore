# .dockerignore
# these files are NOT copied into the container
# keeps image small and fast to build

# python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.py[cod]

# virtual environments
.venv/
venv/
env/
ENV/

# uv cache
.uv/

# environment file
.env
.env.*
!.env.example    # allow example file

# git
.git/
.gitignore

# docker files themselves
Dockerfile
docker-compose.yml
.dockerignore

# editor files
.vscode/
.idea/
*.swp
*.swo

# logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# test files
tests/
pytest.ini
.pytest_cache/

# readme and docs
README.md
docs/